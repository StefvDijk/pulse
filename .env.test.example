# Copy to .env.test.local and fill the keys from `supabase status -o env`.
# Test and seed commands refuse non-loopback Supabase URLs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
PULSE_USER_ID=<local-test-user-id>

# Playwright deliberately uses separate names so `.env.local` cannot silently
# select production. Export these before running `pnpm test:e2e`.
PULSE_E2E_SUPABASE_URL=http://127.0.0.1:54321
PULSE_E2E_SUPABASE_ANON_KEY=<local-anon-key>
PULSE_E2E_SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
PULSE_E2E_USER_ID=<local-test-user-id>
TEST_USER_EMAIL=pulse-e2e@example.test
TEST_USER_PASSWORD=<local-test-password>
